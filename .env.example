# MCP server (https://github.com/richateresamohankeyvalue/agent-sdk-bakeoff-mcp-server)
# Start separately: docker compose up --build  (in that repo)
MCP_SERVER_URL=http://localhost:8081/sse
MCP_TRANSPORT=sse

# Model the agent runs on, routed through LiteLLM.
# Change this one line to swap models — same script, zero other changes.
AGENT_MODEL_ID=claude-sonnet-5
LITELLM_API_KEY=
LITELLM_BASE_URL=

# Reviewer + grader use a different, smaller model.
REVIEWER_MODEL_ID=claude-haiku-4-5-20251001
GRADER_MODEL_ID=claude-haiku-4-5-20251001

# PostgreSQL for memory (matches docker-compose.yml defaults).
AGENT_DB_URL=postgresql+psycopg://ai:ai@localhost:5532/ai
