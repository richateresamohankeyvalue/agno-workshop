# MCP server (github.com/richateresamohankeyvalue/agent-sdk-bakeoff-mcp-server),
# run via `docker compose up --build` in that repo.
MCP_SERVER_URL=http://localhost:8081/sse
MCP_TRANSPORT=sse

# Model the agent runs on, routed through LiteLLM.
# The `litellm_proxy/` prefix matters: it tells the LiteLLM SDK "this is
# another LiteLLM proxy" so it passes the model string through unmodified.
# Without it, the SDK recognizes `anthropic/` as its own provider routing
# and strips that prefix before the request reaches the proxy, which then
# fails the proxy's model-allowlist check (it matches on the full string).
AGENT_MODEL_ID=litellm_proxy/anthropic/claude-sonnet-5
LITELLM_API_KEY=
LITELLM_BASE_URL=

# PostgreSQL for memory (matches docker-compose.yml defaults).
AGENT_DB_URL=postgresql+psycopg://ai:ai@localhost:5532/ai
