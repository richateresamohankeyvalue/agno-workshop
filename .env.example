# MCP server (github.com/richateresamohankeyvalue/agent-sdk-bakeoff-mcp-server),
# run via `docker compose up --build` in that repo.
MCP_SERVER_URL=http://localhost:8081/sse
MCP_TRANSPORT=sse

# Model the agent runs on, routed through LiteLLM. Leave LITELLM_BASE_URL
# unset to call the provider directly through the LiteLLM SDK (model id then
# needs a provider prefix, e.g. "anthropic/claude-sonnet-5"); set it to point
# at a self-hosted/managed LiteLLM proxy instead (model id then uses whatever
# alias that proxy expects).
AGENT_MODEL_ID=claude-sonnet-5
LITELLM_API_KEY=
LITELLM_BASE_URL=
